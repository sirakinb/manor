{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/design",
      "!**/packages/db/src/generated",
      "!**/apps/mobile/.expo",
      "!**/playwright-report",
      "!**/test-results",
      "!**/test-report",
      "!**/verify-report",
      "!**/data",
      "!**/*.astro",
      "!**/apps/www"
    ]
  },
  "plugins": [
    {
      "path": "./scripts/biome/no-hex-colors.grit",
      "includes": [
        "**/apps/web/src/**/*.tsx",
        "**/packages/ui-web/src/**/*.tsx",
        "!**/*.test.tsx",
        "!**/packages/ui-web/src/bot-avatar.tsx",
        "!**/apps/web/src/pages/WindowChrome.tsx",
        "!**/apps/web/src/pages/workspace/**",
        "!**/apps/web/src/pages/crm/**",
        "!**/apps/web/src/pages/AgentConnectionSetup.tsx",
        "!**/apps/web/src/pages/CrmApiAccessPanel.tsx",
        "!**/apps/web/src/pages/DocsView.tsx",
        "!**/apps/web/src/pages/OAuthAuthorize.tsx",
        "!**/apps/web/src/pages/UserGuide.tsx",
        "!**/apps/web/src/pages/Welcome.tsx",
        "!**/apps/web/src/components/BotCredentialsSettings.tsx",
        "!**/apps/web/src/components/ChartCanvas.tsx",
        "!**/apps/web/src/components/FilesPanel.tsx",
        "!**/apps/web/src/components/RunLogsPanel.tsx",
        "!**/apps/web/src/components/ShareThisMacSettings.tsx",
        "!**/apps/web/src/components/TeamMembers.tsx",
        "!**/apps/web/src/components/VerificationComparison.tsx",
        "!**/apps/web/src/components/WorkspacePdfPreview.tsx",
        "!**/apps/web/src/components/ai/ParticleWordmark.tsx",
        "!**/apps/web/src/components/ai/manor-primitives.tsx",
        "!**/apps/web/src/App.tsx",
        "!**/apps/web/src/pages/Auth.tsx",
        "!**/apps/web/src/pages/Auth.test.tsx",
        "!**/apps/web/src/pages/PluginsOverlay.tsx",
        "!**/apps/web/src/pages/Shell.tsx",
        "!**/apps/web/src/pages/shell/composer.tsx",
        "!**/apps/web/src/pages/shell/computer-overlay.tsx",
        "!**/apps/web/src/pages/shell/computer-panel.tsx",
        "!**/apps/web/src/pages/shell/message-view.tsx",
        "!**/apps/web/src/pages/shell/sidebar-header.tsx",
        "!**/apps/web/src/pages/shell/sidebar-roster.tsx",
        "!**/apps/web/src/pages/shell/transcript.tsx"
      ]
    },
    {
      "path": "./scripts/biome/no-css-var-arbitrary-values.grit",
      "includes": [
        "**/apps/web/src/**/*.tsx",
        "**/packages/ui-web/src/**/*.tsx",
        "!**/apps/web/src/pages/workspace/**",
        "!**/apps/web/src/pages/crm/**",
        "!**/apps/web/src/pages/AgentConnectionSetup.tsx",
        "!**/apps/web/src/pages/CrmApiAccessPanel.tsx",
        "!**/apps/web/src/pages/DocsView.tsx",
        "!**/apps/web/src/pages/OAuthAuthorize.tsx",
        "!**/apps/web/src/pages/UserGuide.tsx",
        "!**/apps/web/src/pages/Welcome.tsx",
        "!**/apps/web/src/components/BotCredentialsSettings.tsx",
        "!**/apps/web/src/components/ChartCanvas.tsx",
        "!**/apps/web/src/components/FilesPanel.tsx",
        "!**/apps/web/src/components/RunLogsPanel.tsx",
        "!**/apps/web/src/components/ShareThisMacSettings.tsx",
        "!**/apps/web/src/components/TeamMembers.tsx",
        "!**/apps/web/src/components/VerificationComparison.tsx",
        "!**/apps/web/src/components/WorkspacePdfPreview.tsx",
        "!**/apps/web/src/components/ai/ParticleWordmark.tsx",
        "!**/apps/web/src/components/ai/manor-primitives.tsx",
        "!**/apps/web/src/App.tsx",
        "!**/apps/web/src/pages/Auth.tsx",
        "!**/apps/web/src/pages/Auth.test.tsx",
        "!**/apps/web/src/pages/PluginsOverlay.tsx",
        "!**/apps/web/src/pages/Shell.tsx",
        "!**/apps/web/src/pages/shell/composer.tsx",
        "!**/apps/web/src/pages/shell/computer-overlay.tsx",
        "!**/apps/web/src/pages/shell/computer-panel.tsx",
        "!**/apps/web/src/pages/shell/message-view.tsx",
        "!**/apps/web/src/pages/shell/sidebar-header.tsx",
        "!**/apps/web/src/pages/shell/sidebar-roster.tsx",
        "!**/apps/web/src/pages/shell/transcript.tsx"
      ]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": { "level": "error", "options": { "style": "separatedType" } }
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui-web/src/components/ui/**", "packages/ui-web/src/shadcn.css"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/**",
        "apps/worker/**",
        "infra/sandboxes/supervisor/**",
        "infra/updater/**",
        "packages/adapters/**",
        "packages/db/**",
        "packages/logging/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/logging/src/console-sink.ts", "packages/logging/src/sink-guard.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["infra/bridges/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    }
  ]
}

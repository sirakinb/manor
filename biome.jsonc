{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/design",
      "!**/packages/db/src/generated",
      "!**/apps/mobile/.expo",
      "!**/playwright-report",
      "!**/test-results",
      "!**/test-report",
      "!**/verify-report",
      "!**/data",
      "!**/*.astro",
      "!**/apps/www/.astro",
      "!**/apps/www/.vercel",
      "!**/apps/www/**/*.{css,json,mjs}"
    ]
  },
  "plugins": [
    {
      "path": "./scripts/biome/no-hex-colors.grit",
      "includes": [
        "**/apps/web/src/**/*.tsx",
        "**/packages/ui-web/src/**/*.tsx",
        "**/apps/mobile/**/*.tsx",
        "**/packages/chat-ui/**/*.tsx",
        "!**/*.test.tsx",
        "!**/packages/ui-web/src/bot-avatar.tsx",
        "!**/apps/mobile/components/bots/bot-avatar.tsx",
        "!**/apps/mobile/app/files.tsx",
        "!**/apps/mobile/app/run-logs.tsx",
        "!**/apps/mobile/app/sign-in.tsx",
        "!**/apps/mobile/components/team-members.tsx",
        "!**/apps/mobile/components/thread/message-bubble.tsx",
        "!**/apps/mobile/components/thread/reply-verification-note.tsx",
        "!**/apps/mobile/components/crm-kit.tsx",
        "!**/apps/mobile/components/crm-pipeline.tsx",
        "!**/apps/web/src/components/WindowChrome.tsx",
        "!**/apps/web/src/pages/workspace/**",
        "!**/apps/web/src/pages/crm/**",
        "!**/apps/web/src/pages/AgentConnectionSetup.tsx",
        "!**/apps/web/src/pages/CrmApiAccessPanel.tsx",
        "!**/apps/web/src/pages/DocsView.tsx",
        "!**/apps/web/src/pages/OAuthAuthorize.tsx",
        "!**/apps/web/src/pages/UserGuide.tsx",
        "!**/apps/web/src/pages/Welcome.tsx",
        "!**/apps/web/src/components/BotCredentialsSettings.tsx",
        "!**/apps/web/src/components/ChartCanvas.tsx",
        "!**/apps/web/src/components/FilesPanel.tsx",
        "!**/apps/web/src/components/RunLogsPanel.tsx",
        "!**/apps/web/src/components/ShareThisMacSettings.tsx",
        "!**/apps/web/src/components/TeamMembers.tsx",
        "!**/apps/web/src/components/VerificationComparison.tsx",
        "!**/apps/web/src/components/WorkspacePdfPreview.tsx",
        "!**/apps/web/src/components/ai/ParticleWordmark.tsx",
        "!**/apps/web/src/components/ai/manor-primitives.tsx",
        "!**/apps/web/src/App.tsx",
        "!**/apps/web/src/pages/auth/Auth.tsx",
        "!**/apps/web/src/pages/auth/Auth.test.tsx",
        "!**/apps/web/src/pages/plugins/PluginsOverlay.tsx",
        "!**/apps/web/src/pages/Shell.tsx",
        "!**/apps/web/src/pages/shell/composer/composer.tsx",
        "!**/apps/web/src/pages/shell/computers/computer-overlay.tsx",
        "!**/apps/web/src/pages/shell/computers/computer-panel.tsx",
        "!**/apps/web/src/pages/shell/chat/message-view.tsx",
        "!**/apps/web/src/pages/shell/sidebar/sidebar-header.tsx",
        "!**/apps/web/src/pages/shell/sidebar/sidebar-roster.tsx",
        "!**/apps/web/src/pages/shell/chat/transcript.tsx"
      ]
    },
    {
      "path": "./scripts/biome/no-css-var-arbitrary-values.grit",
      "includes": [
        "**/apps/web/src/**/*.tsx",
        "**/packages/ui-web/src/**/*.tsx",
        "!**/apps/web/src/pages/workspace/**",
        "!**/apps/web/src/pages/crm/**",
        "!**/apps/web/src/pages/AgentConnectionSetup.tsx",
        "!**/apps/web/src/pages/CrmApiAccessPanel.tsx",
        "!**/apps/web/src/pages/DocsView.tsx",
        "!**/apps/web/src/pages/OAuthAuthorize.tsx",
        "!**/apps/web/src/pages/UserGuide.tsx",
        "!**/apps/web/src/pages/Welcome.tsx",
        "!**/apps/web/src/components/BotCredentialsSettings.tsx",
        "!**/apps/web/src/components/ChartCanvas.tsx",
        "!**/apps/web/src/components/FilesPanel.tsx",
        "!**/apps/web/src/components/RunLogsPanel.tsx",
        "!**/apps/web/src/components/ShareThisMacSettings.tsx",
        "!**/apps/web/src/components/TeamMembers.tsx",
        "!**/apps/web/src/components/VerificationComparison.tsx",
        "!**/apps/web/src/components/WorkspacePdfPreview.tsx",
        "!**/apps/web/src/components/ai/ParticleWordmark.tsx",
        "!**/apps/web/src/components/ai/manor-primitives.tsx",
        "!**/apps/web/src/App.tsx",
        "!**/apps/web/src/pages/auth/Auth.tsx",
        "!**/apps/web/src/pages/auth/Auth.test.tsx",
        "!**/apps/web/src/pages/plugins/PluginsOverlay.tsx",
        "!**/apps/web/src/pages/Shell.tsx",
        "!**/apps/web/src/pages/shell/composer/composer.tsx",
        "!**/apps/web/src/pages/shell/computers/computer-overlay.tsx",
        "!**/apps/web/src/pages/shell/computers/computer-panel.tsx",
        "!**/apps/web/src/pages/shell/chat/message-view.tsx",
        "!**/apps/web/src/pages/shell/sidebar/sidebar-header.tsx",
        "!**/apps/web/src/pages/shell/sidebar/sidebar-roster.tsx",
        "!**/apps/web/src/pages/shell/chat/transcript.tsx"
      ]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": { "level": "error", "options": { "style": "separatedType" } },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@{alicloud,aws-sdk,axiomhq,azure,boatdev,boxd-sh,chat-adapter}/**",
                  "@{composio,darabonba,daytona,e2b,insforge,kubernetes}/**",
                  "@{larksuiteoapi,opentelemetry,photon-ai,sentry,stripe}/**",
                  "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}",
                  "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}/**"
                ],
                "message": "This is a vendor SDK. Extend the provider-neutral interface in `@rakazo/adapter-kit`, implement it in `packages/adapters`, and load the SDK there with `import()`."
              }
            ]
          }
        }
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**", "packages/chat-ui/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              // Our components that render string children inside a Text (Label and Empty are
              // Manor's CRM kit, apps/mobile/components/crm-kit.tsx).
              "options": {
                "skip": [
                  "SvgText",
                  "ChatMarkdown",
                  "LinkifiedText",
                  "SettingsLabel",
                  "Label",
                  "Empty"
                ]
              }
            }
          }
        }
      }
    },
    {
      // Tests render mocked React Native through react-dom, so raw text there never reaches a
      // native view, and harness components are created once per test, not on each render.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": "off",
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui-web/src/components/ui/**", "packages/ui-web/src/shadcn.css"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/**",
        "apps/worker/**",
        "infra/sandboxes/supervisor/**",
        "infra/updater/**",
        "packages/adapters/**",
        "packages/db/**",
        "packages/logging/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/logging/src/console-sink.ts", "packages/logging/src/sink-guard.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["infra/bridges/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    // Adapters are where vendor SDKs live. The monitoring and logging sinks and the screenshot
    // publisher load theirs on demand.
    {
      "includes": [
        "packages/adapters/**",
        "apps/desktop/src/main/system/monitoring.ts",
        "apps/web/src/lib/platform/monitoring.ts",
        "apps/mobile/lib/platform/monitoring.ts",
        "packages/logging/src/sentry.ts",
        "packages/logging/src/sentry.test.ts",
        "packages/logging/src/axiom-sink.ts",
        "packages/testkit/src/screenshots/ios-screenshot-publish.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}

{
  "expo": {
    "name": "Manor",
    "slug": "manor",
    "owner": "defipapi-org",
    "scheme": "manor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A855F7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Manor uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Manor uses the camera so you can attach photos to a bot message.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-worklets-headers"
    ],
    "ios": {
      "bundleIdentifier": "com.pentridgemedia.manor",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Manor uses the camera so you can attach photos to a bot message.",
        "NSPhotoLibraryUsageDescription": "Manor uses your photo library so you can attach images to a bot message.",
        "NSLocalNetworkUsageDescription": "Manor connects to a self-hosted Manor server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.pentridgemedia.manor",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#050506"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10b6d66c-519d-4222-b5bb-4c68bd275905"
      }
    }
  }
}

{
  "expo": {
    "name": "Manor",
    "slug": "manor",
    "owner": "defipapi-org",
    "scheme": "manor",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Manor uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Manor turns your speech into messages during voice calls.",
          "microphonePermission": "Manor uses the microphone for voice calls with your bots."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A855F7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Manor uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Manor uses the camera so you can attach photos to a bot message.",
          "microphonePermission": "Manor uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ]
          }
        }
      ],
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-lan-cleartext",
      "./plugins/with-agent-notifications",
      "./plugins/with-android-r8",
      "./plugins/with-app-intents"
    ],
    "locales": {
      "es": "./locales/es.json",
      "pl": "./locales/pl.json"
    },
    "ios": {
      "bundleIdentifier": "com.pentridgemedia.manor",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Manor uses the camera so you can attach photos to a bot message.",
        "NSPhotoLibraryUsageDescription": "Manor uses your photo library so you can attach images to a bot message.",
        "NSLocalNetworkUsageDescription": "Manor connects to a self-hosted Manor server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["voip", "audio", "remote-notification"],
        "NSUserActivityTypes": ["INSendMessageIntent"]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.usernotifications.communication": true
      }
    },
    "android": {
      "package": "com.pentridgemedia.manor",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#050506"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "eas": {
        "projectId": "10b6d66c-519d-4222-b5bb-4c68bd275905",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RakazoWidgets",
                  "bundleIdentifier": "com.pentridgemedia.manor.widgets"
                },
                {
                  "targetName": "AgentNotifications",
                  "bundleIdentifier": "com.pentridgemedia.manor.notifications",
                  "entitlements": {
                    "com.apple.developer.usernotifications.communication": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}

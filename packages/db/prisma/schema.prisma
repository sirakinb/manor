  eventsDigest       String?
  rules              MeetingCalendarRule[]
  bookings           MeetingCalendarBooking[]

  @@unique([spaceId, userId])
  @@unique([provider, externalCalendarId])
  @@map("meeting_calendar_connections")
}

model MeetingCalendarAuthorization {

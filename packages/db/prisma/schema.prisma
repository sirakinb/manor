  connection    MeetingCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scope         String
  targetId      String
  botId         String?
  eventStartsAt DateTime?
  seriesId      String?

  @@id([connectionId, scope, targetId])
  @@map("meeting_calendar_rules")
}

model MeetingCalendarBooking {
  connectionId String
  connection   MeetingCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  eventId      String
  sessionId    String
  startsAt     DateTime
  linked       Boolean                   @default(false)
  configDigest String

  @@id([connectionId, eventId])
  @@index([sessionId])
  @@map("meeting_calendar_bookings")
}

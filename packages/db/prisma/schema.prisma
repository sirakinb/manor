/// Operator grants; never purchased model credits. Counter includes uncertain reservations.
model SpeechAllowance {
  userId String @id
  limitMicros BigInt
  usedMicros BigInt @default(0)
  expiresAt DateTime
  @@map("speech_allowances")
}

/// Financial evidence survives chat deletion; contains no audio, transcripts or credentials.
model SpeechCost {
  id String @id
  userId String
  spaceId String
  callId String?
  provider String
  operation String
  model String
  unit String
  units Float?
  billableUnits Json?
  observedModel String?
  observedUnit String?
  accountedMicros BigInt
  confirmationSource String?
  confirmationReference String? @unique
  reservedMicros BigInt
  costMicros BigInt?
  microsPerUnit Float
  pricingSource String
  pricingVersion String
  providerRequestId String?
  state String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  @@index([userId, createdAt], map: "speech_costs_account")
  @@index([spaceId, createdAt], map: "speech_costs_space")
  @@index([state, createdAt], map: "speech_costs_reconcile")
  @@map("speech_costs")
}

/// A bot's attendance and transcript import, scoped to the member who requested it.
model MeetingSession {
  id           String    @id @default(cuid())
  spaceId      String
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId        String
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  platform     String
  status       String
  meetingUrl   String?   @db.Text
  activeKey    String?   @unique
  externalId   String?
  recordingId  String?
  transcriptId String?
  transcript   String?   @db.Text
  error        String?
  requestedAt  DateTime?
  receivedAt   DateTime?
  closedAt     DateTime?
  expiresAt    DateTime
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())

  @@index([spaceId, userId, botId, createdAt])
  @@index([spaceId, createdAt])
  @@index([userId])
  @@unique([provider, externalId])
  @@index([spaceId, scheduledFor])
  @@map("meeting_sessions")
}

model MeetingCalendarConnection {
  id                 String                  @id

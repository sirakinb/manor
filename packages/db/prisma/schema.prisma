  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId String
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  ciphertext String
  /// Sender address of the person who installed it, as inbound messages carry it.
  ownerAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([provider, workspaceId])
  @@index([spaceId, userId])
  identities MessagingIdentity[]
  @@map("messaging_installations")
}

model MessagingInstallSession {

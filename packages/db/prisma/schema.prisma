  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String   @unique
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  secretId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("browser_profiles")
}

model ComputerUpdate {
  action     String   @default("update")
  id         String   @id @default(cuid())
  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  botId      String
  status     String   @default("queued")
  stage      String   @default("preparing")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([computerId, createdAt])
  @@index([status, updatedAt])
  @@map("computer_updates")
}

model Computer {
  screenGeneration Int @default(0)
  id                      String                   @id @default(cuid())
  spaceId                 String
  space                   Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                  String
  scope                   String                   @default("team")
  scopeKey                String                   @unique
  homeKey                 String                   @unique
  homeRevision            String                   @default("empty")
  /// When the sandbox was read for `homeRevision`; null when an older release saved it.
  homeRevisionAt          DateTime?
  /// When a damaged system last made Rakazo stop and start the computer by itself. Tried once
  /// until a later save shows the computer works again.
  autoRecoveredAt         DateTime?
  /// The machine at `providerRef` came from a start whose restore never finished, so it holds no
  /// full copy of the saved home: nothing is saved from it, and the next start restores it.
  restorePending          Boolean                  @default(false)
  /// Object storage only: random id naming the home's objects, its data key (wrapped by the
  /// space key) and the revision stored there. Deleting the computer deletes the key.
  homeStorageId           String?                  @unique
  homeStorageKey          String?
  homeStorageRevision     String?
  kind                    String
  providerRef             String?
  state                   String                   @default("stopped")
  controlHolder           String                   @default("none")
  controlLeaseId          String?
  controlLeaseExpiresAt   DateTime?
  controlBotId            String?
  /// The person holding user control. A Space's members share its computers, never a lease.
  controlUserId           String?
  controlFence            Int                      @default(0)
  screenUrl               String?
  /// When the computer last started running; bounds how long it can stay up in one stretch.
  runningSince            DateTime?
  /// The home's disk as the computer last reported it; null where it was never measured.
  diskUsedBytes           BigInt?
  diskFreeBytes           BigInt?
  /// How full the disk was when the user hid its warning; the warning returns once it is fuller.
  diskDismissedPercent    Int?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bots                    Bot[]
  executionLeases         ComputerExecutionLease[]
  localSessions           LocalComputerSession[]
  maintenanceId           String?
  updates                 ComputerUpdate[]
  homeDeletionNotice      HomeDeletionNotice?

  @@index([spaceId, scope])
  @@map("computers")
}

/// Hosted billing only: a stopped computer whose saved home is due for deletion after its plan
/// ended or it went unused.
model HomeDeletionNotice {
  computerId     String    @id
  computer       Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  /// When the owner was emailed; null until then, and nothing is deleted before it.
  warnedAt       DateTime?
  /// The deletion date the email gave.
  deleteAfter    DateTime?
  createdAt      DateTime  @default(now())

  @@map("home_deletion_notices")
}

/// One holder at a time for long work across processes. `withLease` in packages/db/src/database/leases.ts
/// is the only writer. A release deletes its row; `fence` comes from `leases_fence_seq`, so a key's
/// next holder always outranks every earlier one.
model Lease {
  key       String   @id
  fence     BigInt
  expiresAt DateTime @db.Timestamptz(3)

  @@map("leases")
}

/// One stretch a computer ran at its provider, from `computers.runningSince` until it stopped,
/// attributed to the computer's owning user and space. Run time is what sandbox providers bill.
///
/// `computerId` is deliberately not a relation, so the row outlives a deleted computer. Deleting
/// the user or space anonymises the row instead of erasing the run time it records.
model ComputerRun {
  id         String    @id @default(cuid())
  computerId String
  spaceId    String?
  space      Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind       String
  /// The provider's id for the sandbox, to match runs with the provider's own usage and billing.
  providerRef String?
  startedAt  DateTime
  /// Null while running. When the end was not seen as it happened, this is when it was detected.
  endedAt    DateTime?
  /// How it ended; see `ComputerRunEnd` in packages/db/src/computers/computer-runs.ts.
  endReason  String?
  /// When Rakazo last saw this stretch running: at its start and at each idle check.
  lastSeenAt DateTime?

  @@unique([computerId, startedAt])
  @@index([spaceId, userId, startedAt])
  // computer_runs_open_idx (open runs by computer) is raw SQL: Prisma cannot express partial indexes.
  @@map("computer_runs")
}

model ComputerExecutionLease {
  id         String   @id @default(cuid())
  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  botId      String
  runId      String
  fence      Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([computerId, botId])
  @@index([runId])
  @@index([computerId, expiresAt])
  @@index([botId, expiresAt])
  @@map("computer_execution_leases")
}

/// Paired Manor desktop app. Token hash only; the plaintext token never stays in the database.
model LocalDevice {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId     String
  space       Space                  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String                 @default("Laptop")
  tokenHash   String                 @unique
  tokenPrefix String
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime               @default(now())
  sessions    LocalComputerSession[]

  @@index([userId, spaceId])
  @@map("local_devices")
}

/// One attended share: a single folder, live only while the desktop app is connected.
model LocalComputerSession {
  id          String                 @id @default(cuid())
  deviceId    String
  device      LocalDevice            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  computerId  String
  computer    Computer               @relation(fields: [computerId], references: [id], onDelete: Cascade)
  spaceId     String
  space       Space                  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  folderName  String
  connected   Boolean                @default(false)
  lastCommand String                 @default("")
  startedAt   DateTime               @default(now())
  stoppedAt   DateTime?
  commands    LocalComputerCommand[]

  @@index([deviceId, connected])
  @@index([spaceId, userId, connected])
  @@index([computerId])
  @@map("local_computer_sessions")
}

/// Worker-to-desktop RPC payload. NOTIFY only carries this row's id.
model LocalComputerCommand {
  id          String               @id @default(cuid())
  sessionId   String
  session     LocalComputerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  method      String
  params      Json
  result      Json?
  error       String?
  status      String               @default("pending")
  createdAt   DateTime             @default(now())
  completedAt DateTime?

  @@index([sessionId, status, createdAt])
  @@map("local_computer_commands")
}

model Artifact {
  id         String     @id @default(cuid())
  spaceId    String
  space      Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId      String?
  bot        Bot?       @relation(fields: [botId], references: [id], onDelete: SetNull)
  groupId    String?
  group      ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  runId      String?
  name       String
  description String?
  mimeType   String
  size       Int
  hash       String
  storageKey String
  createdAt  DateTime   @default(now())

  // Null on the first version; that row's id is the family's stable id.
  rootArtifactId String?
  rootArtifact   Artifact?  @relation("ArtifactVersions", fields: [rootArtifactId], references: [id], onDelete: Cascade)
  versions       Artifact[] @relation("ArtifactVersions")
  version        Int        @default(1)
  // A file a stranger emailed: its own family, never one a later upload of that name joins.
  standalone     Boolean    @default(false)
  // Client-chosen per upload so a retried upload that already landed returns this row.
  clientNonce    String?

  @@unique([spaceId, userId, clientNonce])
  @@index([spaceId, botId])
  @@index([groupId])
  @@index([rootArtifactId])
  // artifacts_family_version_key is raw SQL: Prisma cannot express COALESCE indexes.
  @@map("artifacts")
}

/// A page a bot built: a report, dashboard or tracker the user opens from chat and can share.
model Page {
  id             String        @id @default(cuid())
  spaceId        String
  space          Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId          String?
  bot            Bot?          @relation(fields: [botId], references: [id], onDelete: SetNull)
  groupId        String?
  group          ChatGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title          String
  visibility     String        @default("private")
  /// sha256 of the link token; the public read looks pages up by it.
  shareTokenHash String?       @unique
  /// The link token itself, sealed in the secret store so the owner can copy the link again.
  shareSecretId  String?       @unique
  shareSecret    Secret?       @relation(fields: [shareSecretId], references: [id], onDelete: SetNull)
  pinnedAt       DateTime?
  currentVersion Int           @default(1)
  createdAt      DateTime      @default(now())
  /// Set when the page's content or title changes; pinning or sharing it is not an update.
  updatedAt      DateTime      @default(now())
  versions       PageVersion[]

  @@index([spaceId, userId, updatedAt])
  @@index([botId])
  @@index([groupId])
  @@map("pages")
}

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  title     String
  source    String
  /// The source compiled for the viewer when it was saved, so reads never run the compiler.
  code      String
  createdAt DateTime @default(now())

  @@unique([pageId, version])
  @@map("page_versions")
}

model UsageRecord {
  /// Operator expenses never settle purchased model credits.
  fundingSource      String   @default("customer")
  id                 String   @id @default(cuid())
  spaceId            String
  /// Which bot spent this. Deliberately not a relation: usage is spend that really happened,
  /// and deleting a bot (which also deletes its runs) must not delete the row or blank its
  /// attribution, as Cascade or SetNull would. The id may dangle; read it with a LEFT JOIN.
  /// `BotDeletion.id` is the bot id, so a deleted bot's name stays reachable for display.
  botId              String?
  userId             String
  runId              String?
  provider           String
  model              String
  /// Uncached input; cache buckets are additional, reasoning is a subset of output.
  inputTokens        Int?
  outputTokens       Int?
  cacheReadTokens    Int?
  cacheWriteTokens   Int?
  cacheWrite1hTokens Int?
  reasoningTokens    Int?
  totalTokens        Int?
  costUsd            Float?
  providerRequestId  String?
  currency           String   @default("usd")
  auditRevision      Int      @default(0)
  costSource         String?
  pricingVersion     String?
  pricingSnapshot    Json?
  usageSource        String?
  callId             String?  @unique
  operationId        String?
  operationKind      String   @default("answer")
  /// Durable attribution, deliberately without lifecycle foreign keys.
  parentRunId        String?
  agentId            String?
  createdAt          DateTime @default(now())

  @@index([spaceId, userId, createdAt])
  @@map("usage_records")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  spaceId  String
  space    Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  finish   Boolean @default(true)
  help     Boolean @default(true)
  takeover Boolean @default(true)

  @@unique([spaceId, userId])
  @@map("notification_preferences")
}

model SpaceMemoryConfig {
  id                 String   @id @default(cuid())
  spaceId            String   @unique
  space              Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId             String
  provider           String
  settings           Json
  secretId           String   @unique
  secret             Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  defaultMemoryScope String   @default("isolated")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("space_memory_configs")
}

model Secret {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId              String?
  space                Space?                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind                 String
  ciphertext           String
  createdAt            DateTime              @default(now())
  mcpServers           McpServer[]
  spaceMemoryConfig    SpaceMemoryConfig?
  botCredentials       BotCredential[]
  workspaceCredentials WorkspaceCredential[]
  agentSecret          AgentSecret?
  pageShare            Page?

  @@index([userId, spaceId])
  @@map("secrets")
}

model McpServer {
  id            String            @id @default(cuid())
  spaceId       String
  space         Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String
  name          String
  description   String            @default("")
  transport     String
  endpoint      String?
  command       String?
  /// Legacy plaintext; arguments now live in the encrypted secret, and `hasArgs` marks them.
  args          Json              @default("[]")
  hasArgs       Boolean           @default(false)
  env           Json              @default("{}")
  files         Json              @default("{}")
  headers       Json              @default("{}")
  secretId      String?
  secret        Secret?           @relation(fields: [secretId], references: [id], onDelete: SetNull)
  installId     String?
  install       CapabilityInstall? @relation(fields: [installId], references: [id], onDelete: Cascade)
  enabled       Boolean           @default(true)
  /// Tool results from this server stay whole. A result that cannot fit fails the turn.
  verbatimResults Boolean         @default(false)
  revision      Int               @default(1)
  /// Last launch/discovery outcome: unknown | installing | ok | error.
  healthStatus    String          @default("unknown")
  healthMessage   String?
  healthToolCount Int?
  healthCheckedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assignments   BotMcpServer[]
  oauthSessions McpOAuthSession[]
  /// Available in every space of its owner, including later ones; otherwise in spaceId and availableIn.
  allSpaces     Boolean           @default(false)
  availableIn   McpServerSpace[]
  /// Every agent of its owner can use it; otherwise only agents with an assignment.
  allBots       Boolean           @default(false)

  @@unique([spaceId, userId, slug])
  @@index([spaceId, userId])
  @@index([installId])
  @@map("mcp_servers")
}

/// A stored website login a bot may use on its computer. Username/site/notes are
/// plain; password and TOTP seed live encrypted in `secret` and never reach the model.
model BotCredential {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  site        String   @default("")
  username    String   @default("")
  notes       String   @default("")
  hasPassword Boolean  @default(false)
  hasTotp     Boolean  @default(false)
  secretId    String?
  secret      Secret?  @relation(fields: [secretId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spaceId, botId])
  @@map("bot_credentials")
}

model McpOAuthSession {
  id              String    @id
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId          String
  serverId        String
  server          McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  endpoint        String
  redirectUri     String
  oauthCiphertext String
  /// The bot that gets the server once this sign-in finishes.
  botId           String?
  createdAt       DateTime  @default(now())

  @@index([spaceId, userId, createdAt])
  @@map("mcp_oauth_sessions")
}

/// A pending subscription sign-in and its outcome, so any API process can report,
/// finish or cancel it. A pasted-code sign-in's ciphertext holds its PKCE verifier.
model ModelOAuthSession {
  id             String    @id
  spaceId        String
  space          Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId         String
  provider       String
  /// The connection it signs in to; a newer sign-in for the same one replaces it.
  scope          String
  ciphertext     String?
  /// pending, saving, connected or failed.
  status         String    @default("pending")
  error          String?
  /// The saved connection, once connected.
  result         Json?
  /// The process waiting on the provider renews this; a lapsed lease means it is gone.
  leaseExpiresAt DateTime?
  /// Set while the sign-in is measured: the app it began in and which try it is.
  surface        String?
  connectNumber  Int?
  createdAt      DateTime  @default(now())

  @@index([userId, provider])
  @@index([scope])
  @@index([createdAt])
  @@map("model_oauth_sessions")
}

model BotMcpServer {
  id            String    @id @default(cuid())
  spaceId       String
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  serverId      String
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId        String
  allowAllTools Boolean   @default(true)
  allowedTools  Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([botId, serverId])
  @@index([spaceId, userId, botId])
  @@map("bot_mcp_servers")
}

model MessagingIdentity {
  id                   String    @id @default(cuid())
  provider             String
  /// Sender address within the provider: E.164 number, Slack user id, ….
  address              String
  /// Opaque provider thread id for the 1:1 conversation; learned on inbound.
  dmThreadId           String?
  installationId       String?
  installation         MessagingInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)
  userId               String
  spaceId              String
  space                Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                String    @unique
  verifiedAt           DateTime?
  lastInboundAt        DateTime?
  outboundSinceInbound Int       @default(0)
  /// Provider handle of the reply that last released messages held behind the outbound cap.
  /// A redelivery of that reply answers no request: it was sent before they went out.
  capReleaseHandle     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([provider, address])
  @@index([userId])
  @@index([installationId])
  @@map("messaging_identities")
}

model MessagingChannel {
  id            String                   @id @default(cuid())
  provider      String
  threadId      String                   @unique
  name          String?
  introPostedAt DateTime?
  /// The platform time of the newest roster this channel has processed, so a
  /// delayed older roster changes no membership.
  rosterSeenAt  DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  members       MessagingChannelMember[]

  @@map("messaging_channels")
}

model MessagingChannelMember {
  id         String           @id @default(cuid())
  channelId  String
  channel    MessagingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  address    String
  identityId String?
  status     String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([channelId, address])
  @@index([identityId])
  @@map("messaging_channel_members")
}

/// Short-lived web-issued code binding a chat address to an existing user+bot.
model MessagingLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  spaceId   String
  botId     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("messaging_link_codes")
}

/// One outgoing chat message: the record of what was sent, in the order its conversation gets it.
model MessagingOutbound {
  id              String   @id @default(cuid())
  idempotencyKey  String   @unique
  /// dm, group, intro, or team (a team-chat reply).
  kind            String
  /// DM rows resolve their thread through the identity when they are sent.
  identityId      String?
  /// Group, intro and team rows post straight to this provider thread id.
  threadId        String?
  body            String
  /// pending, retry (its backup job retries it), sent or failed. Sent with no providerHandle: in flight.
  status          String   @default("pending")
  providerHandle  String?
  /// Set while this release's claim is in flight. A stale claim without it is the previous
  /// release's, which may well have gone out, so it is never sent again.
  claimedAt       DateTime?
  sourceMessageId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([identityId, createdAt])
  @@index([threadId, createdAt])
  @@index([claimedAt])
  @@index([status, updatedAt])
  @@map("messaging_outbound")
}

model AgentConnection {
  requestVersion Int      @default(1)
  id             String   @id @default(cuid())
  requesterBotId String
  targetBotId    String
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([requesterBotId, targetBotId])
  @@index([targetBotId, status])
  @@map("agent_connections")
}

// ── CRM ──────────────────────────────────────────────────────────────────────
// A service business runs on who it knows and what work is moving. These are
// plain workspace-scoped tables — no coupling to bots or threads — so that
// phase 2 can hand bots CRM tools without touching the schema again.
// Prefixed Crm* because Manor already has a Task model of its own.

model IntegrationCredential {
  id              String    @id @default(cuid())
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  tokenPrefix     String
  tokenHash       String    @unique
  scopes          Json
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  // Set when an MCP client obtained this credential through OAuth; the refresh
  // token rotates the access token in place so the grant stays one revocable row.
  oauthClientId    String?
  oauthClient      OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  refreshTokenHash String?      @unique
  refreshExpiresAt DateTime?

  idempotencyKeys IntegrationIdempotencyKey[]

  @@index([spaceId, revokedAt])
  @@map("integration_credentials")
}

/// An MCP client registered through OAuth dynamic client registration.
model OAuthClient {
  id           String   @id
  name         String
  redirectUris Json
  secretHash   String?
  createdAt    DateTime @default(now())

  credentials IntegrationCredential[]
  codes       OAuthAuthorizationCode[]

  @@map("oauth_clients")
}

model OAuthAuthorizationCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  spaceId       String
  space         Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scopes        Json
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

model IntegrationIdempotencyKey {
  id           String                @id @default(cuid())
  spaceId      String
  space        Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  credentialId String
  credential   IntegrationCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  key          String
  requestHash  String
  statusCode   Int
  response     Json
  createdAt    DateTime              @default(now())
  expiresAt    DateTime

  @@unique([credentialId, key])
  @@index([expiresAt])
  @@map("integration_idempotency_keys")
}

model CrmContact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  company        String?
  notes          String?
  status         String       @default("active") // active | archived
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tags        CrmContactTag[]
  deals       CrmDeal[]
  externalIds CrmContactExternalId[]

  @@index([organizationId, status])
  @@map("crm_contacts")
}

model CrmContactExternalId {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        CrmContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  source         String
  externalId     String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, source, externalId])
  @@index([contactId])
  @@map("crm_contact_external_ids")
}

/// A public signup or scorecard form an organization embeds on its own website. Submissions
/// become CRM contacts; the settings live here so owners can change them without a deploy.
model PublicForm {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Public URL key and CRM contact source: POST /v1/public/forms/<slug>.
  slug           String       @unique
  /// "event" or "scorecard"
  kind           String
  title          String
  enabled        Boolean      @default(true)
  crmTag         String
  /// Websites allowed to submit from a browser, e.g. https://example.com
  allowedOrigins String[]
  /// Optional paragraph added to the confirmation email.
  message        String?
  notifyEmail    String?
  senderName     String?
  signature      String?
  eventStartsAt  DateTime?
  eventMinutes   Int?
  eventTimeZone  String?
  joinUrl        String?
  bookingUrl     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("public_forms")
}

model CrmTag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  createdAt      DateTime     @default(now())

  contacts CrmContactTag[]

  @@unique([organizationId, name])
  @@map("crm_tags")
}

model CrmContactTag {
  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       CrmTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("crm_contact_tags")
}

model CrmPipeline {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stages CrmStage[]
  deals  CrmDeal[]

  @@index([organizationId])
  @@map("crm_pipelines")
}

model CrmStage {
  id         String      @id @default(cuid())
  pipelineId String
  pipeline   CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  position   Int         @default(0)
  color      String?
  createdAt  DateTime    @default(now())

  deals CrmDeal[]

  @@index([pipelineId])
  @@map("crm_stages")
}

model CrmDeal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineId     String
  pipeline       CrmPipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId        String
  stage          CrmStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String
  // Whole dollars. Service-business deal sizes don't need cents, and whole
  // numbers keep every rollup on the dashboard exact.
  value          Int          @default(0)
  status         String       @default("open") // open | won | lost
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, pipelineId])
  @@map("crm_deals")
}

model CrmModule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  fields  CrmModuleField[]
  records CrmModuleRecord[]

  @@index([organizationId])
  @@map("crm_modules")
}

model CrmModuleField {
  id        String    @id @default(cuid())
  moduleId  String
  module    CrmModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  label     String
  type      String // text | number | date | checkbox | select | email | phone | url
  options   Json      @default("[]")
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([moduleId])
  @@map("crm_module_fields")
}

model CrmModuleRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moduleId       String
  module         CrmModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  values         Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, moduleId, createdAt])
  @@map("crm_module_records")
}

model CrmWebhookEndpoint {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  url             String
  signingSecret   String
  events          Json
  enabled         Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  deliveries CrmWebhookDelivery[]

  @@index([organizationId, enabled])
  @@map("crm_webhook_endpoints")
}

model CrmWebhookEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  resourceId     String
  payload        Json
  createdAt      DateTime     @default(now())

  deliveries CrmWebhookDelivery[]

  @@index([organizationId, createdAt])
  @@map("crm_webhook_events")
}

model CrmWebhookDelivery {
  id            String             @id @default(cuid())
  endpointId    String
  endpoint      CrmWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId       String
  event         CrmWebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status        String             @default("pending") // pending | delivering | delivered | dead
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@map("crm_webhook_deliveries")
}

// ── Workspace ────────────────────────────────────────────────────────────────
// A client's operations warehouse: the data its channels (voice, email, social,
// leasing, utilities) produce, the sources that fill it, and what the AI team
// did with it. Ported from the Pentridge Agent Workspace. Exactly one per
// organization, so scoping is "resolve the org's workspace once, then filter
// by workspaceId". Tables carry their source's shape (Buildium, Zoho, REMA)
// because rewriting eight working pipelines buys nothing visible.

model Workspace {
  knowledgeImports WorkspaceKnowledgeImport[]
  id               String                     @id @default(cuid())
  organizationId   String                     @unique
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  slug             String                     @unique
  channels         String[]                   @default([]) // voice | email | social | leasing | utilities
  activityApproval String                     @default("manual") // manual | auto

  monthlyVoiceReportsEnabled Boolean   @default(false)
  monthlyVoiceReportDay      Int       @default(0) // 0 = last day of month, 1-28 = that day
  monthlyVoiceReportHour     Int       @default(9)
  monthlyVoiceLastSentOn     DateTime? @db.Date
  weeklyEmailReportsEnabled  Boolean   @default(false)
  weeklyEmailReportDay       Int       @default(1) // 0 = Sunday
  weeklyEmailReportHour      Int       @default(9)
  weeklyEmailLastSentOn      DateTime? @db.Date
  reportRecipient            String?
  reportReviewerEmail        String?

  // Utilities write path: the ledger account water charges post to, and the
  // line description Buildium shows. Per organization, no longer an env var.
  waterGlAccountId          Int?
  buildiumChargeDescription String @default("Water bill")
  /// Water billing months hidden from the billing view, first day of each month.
  archivedUtilityMonths     DateTime[] @default([]) @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials          WorkspaceCredential[]
  automations          WorkspaceAutomation[]
  sources              WorkspaceSource[]
  syncRuns             WorkspaceSyncRun[]
  voiceCalls           WorkspaceVoiceCall[]
  voiceTranscripts     WorkspaceVoiceTranscript[]
  voiceCallAnalyses    WorkspaceVoiceCallAnalysis[]
  reports              WorkspaceReport[]
  emailCampaigns       WorkspaceEmailCampaign[]
  emailCampaignLinks   WorkspaceEmailCampaignLink[]
  instagramDaily       WorkspaceInstagramDaily[]
  instagramMedia       WorkspaceInstagramMedia[]
  instagramStats       WorkspaceInstagramStats[]
  buildiumApplications WorkspaceBuildiumApplication[]
  buildiumLeases       WorkspaceBuildiumLease[]
  buildiumProperties   WorkspaceBuildiumProperty[]
  buildiumListings     WorkspaceBuildiumListing[]
  buildiumUnits        WorkspaceBuildiumUnit[]
  buildiumFiles        WorkspaceBuildiumFile[]
  remaListings         WorkspaceRemaListing[]
  sheetListings        WorkspaceSheetListing[]
  utilityProperties    WorkspaceUtilityProperty[]
  waterBills           WorkspaceWaterBill[]
  waterBillChargePosts WorkspaceWaterBillChargePost[]
  activities           WorkspaceActivity[]
  skills               WorkspaceSkill[]
  context              WorkspaceContext[]

  @@map("workspaces")
}

/// A client's stored login for one external provider (Buildium, Zoho, ...).
/// The field values live encrypted in a Secret of kind "workspace-credential".
model WorkspaceCredential {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        String // buildium | twilio | zoho-crm | zoho-campaigns | instagram | gmail | openrouter | smtp
  label           String    @default("")
  secretId        String
  secret          Secret    @relation(fields: [secretId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, provider])
  @@map("workspace_credentials")
}

/// A scheduled pipeline run by the ingestion service for one workspace. The
/// registry in packages/db/src/workspace-automations.ts seeds one per channel.
model WorkspaceAutomation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String // voice | email | instagram | buildium | listings | water | recap
  label       String
  pipeline    String // what the ingestion service runs, e.g. zoho-agent-logs
  crons       String[]
  timezone    String    @default("America/New_York")
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs WorkspaceSyncRun[]

  @@unique([workspaceId, key])
  @@index([enabled, nextRunAt])
  @@map("workspace_automations")
}

model WorkspaceSource {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  sourceType       String? // voice | email | social | leasing | utilities
  status           String    @default("planned") // planned | connected | error
  connectionMethod String?
  lastSyncedAt     DateTime?
  config           Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  syncRuns WorkspaceSyncRun[]

  @@unique([workspaceId, name])

# Manor production env for the Hostinger VPS.
# Copy to the repo root as .env.vps and fill in every "change-me" value.
#   cp infra/compose/.env.vps.example .env.vps

NODE_ENV=production

# --- Domain / ingress (Cloudflare Tunnel) ---
RAKAZO_HOST=manor.pentridgemedia.com
BETTER_AUTH_URL=https://manor.pentridgemedia.com
WEB_ORIGIN=https://manor.pentridgemedia.com
API_URL=https://manor.pentridgemedia.com
# Token for the remotely-managed tunnel (Cloudflare Zero Trust -> Networks -> Tunnels).
# The tunnel's public hostname must point at service http://web:5173.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# --- Database (compose-internal; DATABASE_URL is derived in the compose file) ---
POSTGRES_USER=manor
POSTGRES_DB=manor
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Secrets ---
# openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-32-plus-characters
# openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-char-hex
# Dedicated service credentials. Both are required in production, must be at
# least 32 characters, and must differ from each other and BETTER_AUTH_SECRET.
# openssl rand -base64 48
SANDBOX_SUPERVISOR_TOKEN=change-me-32-plus-characters
# openssl rand -base64 48
SCREEN_PROXY_SECRET=change-me-32-plus-characters

# --- Signups ---
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=

# --- Sandboxes (docker provider: bot computers as sibling containers) ---
SANDBOX_PROVIDER=docker
# Pause or stop computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
SANDBOX_COMMAND_TIMEOUT_MS=300000

# --- Agent runtime ---
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
OPENROUTER_API_KEY=change-me
PI_DEFAULT_PROVIDER=openrouter
PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731

# --- Integrations (optional) ---
COMPOSIO_API_KEY=
SMTP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Messaging channels (optional) ---
# Lets a bridge deliver messages to a bot and lets the bot reply. See
# docs/CHANNELS.md for an iMessage (BlueBubbles) walkthrough.
# openssl rand -hex 32
CHANNEL_WEBHOOK_SECRET=
CHANNEL_OUTBOUND_URL=
CHANNEL_OUTBOUND_TOKEN=
# Comma-separated conversation ids the agent may message. Leave empty to allow
# any conversation; set it to pin replies to known chats.
CHANNEL_ALLOWED_CHATS=

# --- Twilio SMS channel (optional) ---
# Gives an agent its own phone number: texts to it start a run, and the agent
# replies from the same number. No bridge or Mac required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_BOT_ID=
# Comma-separated numbers allowed to command the bot. Empty means nobody, since
# a phone number is public.
TWILIO_ALLOWED_FROM=

# Manor production env for the Hostinger VPS.
# Copy to the repo root as .env.vps and fill in every "change-me" value.
#   cp infra/compose/.env.vps.example .env.vps

NODE_ENV=production

# --- Domain / ingress (Cloudflare Tunnel) ---
RAKAZO_HOST=manor.pentridgemedia.com
BETTER_AUTH_URL=https://manor.pentridgemedia.com
WEB_ORIGIN=https://manor.pentridgemedia.com
API_URL=https://manor.pentridgemedia.com
# Token for the remotely-managed tunnel (Cloudflare Zero Trust -> Networks -> Tunnels).
# The tunnel's public hostname must point at service http://web:5173.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# --- Database (compose-internal; DATABASE_URL is derived in the compose file) ---
POSTGRES_USER=manor
POSTGRES_DB=manor
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Secrets ---
# openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-32-plus-characters
# openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-char-hex
# Optional separate service credential; defaults to BETTER_AUTH_SECRET when empty.
SANDBOX_SUPERVISOR_TOKEN=

# --- Signups ---
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=

# --- Sandboxes (docker provider: bot computers as sibling containers) ---
SANDBOX_PROVIDER=docker
# Pause or stop computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
SANDBOX_COMMAND_TIMEOUT_MS=300000

# --- Agent runtime ---
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
OPENROUTER_API_KEY=change-me
PI_DEFAULT_PROVIDER=openrouter
PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731

# --- Integrations (optional) ---
COMPOSIO_API_KEY=
SMTP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

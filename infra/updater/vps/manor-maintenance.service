[Unit]
Description=Manor private maintenance and release control
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=manor-maintenance
RuntimeDirectoryMode=0755
# API/worker bind-mount this directory; replacing its inode strands their socket.
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /usr/local/lib/manor-release/control.py --policy /etc/manor-release/policy.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
MemoryMax=512M
CPUQuota=50%
TasksMax=128
# Install only reviewed controller source outside candidate workspaces. The Unix
# socket exposes role-limited operations, never the host Docker API.

[Install]
WantedBy=multi-user.target
